# Server & Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
HOSPITAL_TIMEZONE=Africa/Cairo

# PostgreSQL 15+ Connection
DATABASE_URL=postgres://teethlink:teethlink_secret@localhost:5432/teethlink_db
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT=2s
DB_STATEMENT_TIMEOUT=5s

# Redis (Optional for multi-instance Socket.io / Idempotency)
REDIS_URL=redis://localhost:6379

# JWT Authentication & Signing Secrets
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex_access_secret_key_teethlink_2026
JWT_REFRESH_SECRET=replace_with_64_byte_random_hex_refresh_secret_key_teethlink_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
FILE_SIGNING_SECRET=replace_with_64_byte_random_hex_file_signing_secret_2026
FILE_SIGNED_URL_TTL_SECONDS=900

# File Uploads (Local Private Storage Path or S3-compatible bucket)
UPLOAD_STORAGE_DIR=./storage/private
MAX_UPLOAD_SIZE_BYTES=10485760
APP_BASE_URL=http://localhost:4000
